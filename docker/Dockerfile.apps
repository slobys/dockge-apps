# Dockge Apps - source-built fork. Upstream image is used only as a base
# for the Docker CLI / Compose plugin and runtime tools.
FROM louislam/dockge:base AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY common ./common
COPY frontend ./frontend
RUN npm run build:frontend

FROM louislam/dockge:base AS production-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM louislam/dockge:base AS runtime
WORKDIR /app
COPY --from=production-deps /app/node_modules ./node_modules
COPY --from=assets /app/frontend-dist ./frontend-dist
COPY package.json tsconfig.json ./
COPY backend ./backend
COPY common ./common
COPY extra ./extra
RUN mkdir -p /app/data
ENV UV_USE_IO_URING=0
VOLUME /app/data
EXPOSE 5001
HEALTHCHECK --interval=60s --timeout=30s --start-period=60s --retries=5 CMD curl -fsS http://127.0.0.1:5001/ >/dev/null || exit 1
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["tsx", "./backend/index.ts"]
